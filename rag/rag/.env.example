# CLOVA Studio API 설정
CLOVA_STUDIO_API_KEY=your_clova_api_key_here
CLOVA_STUDIO_BASE_URL=https://clovastudio.stream.ntruss.com
CLOVA_STUDIO_REQUEST_ID=your_request_id_here

# OpenAI API 설정 (RAGAS 평가용 - 선택사항, 폴백용)
# CLOVA Studio를 우선 사용하며, CLOVA 사용 불가 시에만 필요합니다
# OpenAI API 키는 https://platform.openai.com/api-keys 에서 발급받을 수 있습니다
OPENAI_API_KEY=your_openai_api_key_here

# 서버 설정
HOST=0.0.0.0
PORT=8000
RELOAD=false
DEBUG=false

# 로깅 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# RAGAS RAG API URL (선택사항 - 기본값: http://localhost:8080/api/clovax/chat/completions/HCX-005)
# RAG_API_URL=http://localhost:8080/api/clovax/chat/completions/HCX-005
